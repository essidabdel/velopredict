# Copier ce fichier en ".env" et adapter si besoin. Aucune clé d'API n'est
# requise : toutes les sources de données (Vélib' GBFS, Open-Meteo, calendrier
# des jours fériés) sont publiques et sans authentification.

# ---------------------------------------------------------------------------
# Kafka (apache/kafka, mode KRaft)
# ---------------------------------------------------------------------------
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STATION_STATUS=velib.station_status

# ---------------------------------------------------------------------------
# TimescaleDB (PostgreSQL) — historique des relevés
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433  # 5432 est souvent déjà pris par un PostgreSQL local installé sur la machine
POSTGRES_DB=velopredict
POSTGRES_USER=velopredict
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://velopredict:change-me@localhost:5433/velopredict

# ---------------------------------------------------------------------------
# Redis — état courant des stations
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0

# ---------------------------------------------------------------------------
# Sources Open Data (URLs publiques, pas de clé)
# ---------------------------------------------------------------------------
GBFS_ROOT_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/gbfs.json
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_LAT=48.8566
OPEN_METEO_LON=2.3522
JOURS_FERIES_URL=https://calendrier.api.gouv.fr/jours-feries/metropole.json
SCOLAIRE_CALENDAR_URL=https://data.education.gouv.fr/api/explore/v2.1/catalog/datasets/fr-en-calendrier-scolaire/records
GEO_API_BASE_URL=https://geo.api.gouv.fr/communes

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
INGESTION_POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# API FastAPI
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Frontend (React + Vite)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Outils d'inspection (démo / présentation uniquement, profil "tools") :
#   docker compose --profile tools up -d
# ---------------------------------------------------------------------------
KAFKA_UI_PORT=8081
ADMINER_PORT=8082
REDIS_COMMANDER_PORT=8083
